from piece import Piece
from board import Board
from collections import deque


BOARD_WIDTH = 10
BOARD_HEIGHT = 40

# True: SRS wall kicks. False: a rotation must fit exactly where it is.
USE_KICKS = True

# Cells of the L piece as (dx, dy) from the top-left of its 3x3 box (y grows
# downward). Index = rotation: 0 spawn, 1 right (cw), 2 flipped, 3 left (ccw).
L_CELLS = (
    ((2, 0), (0, 1), (1, 1), (2, 1)),
    ((1, 0), (1, 1), (1, 2), (2, 2)),
    ((0, 1), (1, 1), (2, 1), (0, 2)),
    ((0, 0), (1, 0), (1, 1), (1, 2)),
)

# SRS JLSTZ kicks as (dx, dy) with dy positive = UP, keyed by (from, to).
KICKS = {
    (0, 1): ((0, 0), (-1, 0), (-1, 1), (0, -2), (-1, -2)),
    (1, 0): ((0, 0), (1, 0), (1, -1), (0, 2), (1, 2)),
    (1, 2): ((0, 0), (1, 0), (1, -1), (0, 2), (1, 2)),
    (2, 1): ((0, 0), (-1, 0), (-1, 1), (0, -2), (-1, -2)),
    (2, 3): ((0, 0), (1, 0), (1, 1), (0, -2), (1, -2)),
    (3, 2): ((0, 0), (-1, 0), (-1, -1), (0, 2), (-1, 2)),
    (3, 0): ((0, 0), (-1, 0), (-1, -1), (0, 2), (-1, 2)),
    (0, 3): ((0, 0), (1, 0), (1, 1), (0, -2), (1, -2)),
}


def cells(x, y, rot):
    return [(x + dx, y + dy) for dx, dy in L_CELLS[rot]]


def fits(matrix, x, y, rot):
    for cx, cy in cells(x, y, rot):
        if cx < 0 or cx >= BOARD_WIDTH or cy < 0 or cy >= BOARD_HEIGHT:
            return False
        if matrix[cy][cx] is not None:
            return False

    return True


def rotate(matrix, x, y, rot, direction):
    """Rotate by direction (+1 cw, -1 ccw). Returns (x, y, rot) or None."""
    new_rot = (rot + direction) % 4
    offsets = KICKS[(rot, new_rot)] if USE_KICKS else ((0, 0),)
    for kick_x, kick_y in offsets:
        candidate = (x + kick_x, y - kick_y, new_rot)
        if fits(matrix, *candidate):
            return candidate

    return None


def movegen_l_piece(piece: Piece, board: Board):
    if piece.type != 'l':
        raise ValueError("piece must be an L-piece")

    matrix = board.matrix
    if len(matrix) != BOARD_HEIGHT or any(
        len(row) != BOARD_WIDTH for row in matrix
    ):
        raise ValueError("matrix must have 40 rows and 10 columns")

    # There is no gravity: the piece only shifts and rotates where it is, and
    # space drops it straight down and locks it, so no moves after the drop.
    start = (piece.x, piece.y, 0)
    if not fits(matrix, *start):
        return []

    queue = deque([start])
    visited = {start}
    landings = {}

    while queue:
        x, y, rot = queue.popleft()

        drop_y = y
        while fits(matrix, x, drop_y + 1, rot):
            drop_y += 1
        landings[frozenset(cells(x, drop_y, rot))] = (x, drop_y, rot)

        next_positions = (
            (x - 1, y, rot),
            (x + 1, y, rot),
            rotate(matrix, x, y, rot, 1),
            rotate(matrix, x, y, rot, -1),
        )
        for position in next_positions:
            if (
                position is not None
                and position not in visited
                and fits(matrix, *position)
            ):
                visited.add(position)
                queue.append(position)

    return sorted(landings.values())
